{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "backend", "app.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5180"],
      "env": { "BACKEND_URL": "http://127.0.0.1:8010" },
      "port": 5180,
      "autoPort": false
    }
  ]
}

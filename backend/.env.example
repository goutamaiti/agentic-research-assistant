# Copy to backend/.env and fill in values. Never commit backend/.env.
# All variables are read server-side only; nothing here is sent to the frontend.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (the Vite dev server proxies /api, so this
# only matters when the frontend calls the backend directly).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (relative paths resolve against the project root, not the CWD) ---
STORAGE_DIR=storage
# Optional overrides; default to sub-directories of STORAGE_DIR. A relative SQLite path
# in DATABASE_URL is also resolved against the project root.
# DATABASE_URL=sqlite:///storage/database/app.db
# CHROMA_DIR=storage/chroma

# --- Upload limits ---
MAX_UPLOAD_MB=30

# --- LLM (Google Gemini via the google-genai SDK) ---
# Keep only GEMINI_API_KEY set. If GOOGLE_API_KEY is also set in your shell,
# the SDK gives it precedence, which can silently select the wrong key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-cos-v1

# --- Workflow ---
MAX_VERIFICATION_RETRIES=2

# --- Third-party telemetry ---
ANONYMIZED_TELEMETRY=False

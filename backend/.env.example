# Copy to backend/.env and fill in values. Never commit backend/.env.
# All variables are read server-side only; nothing here is sent to the frontend.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (the Vite dev server proxies /api, so this
# only matters when the frontend calls the backend directly).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (relative paths resolve against the project root, not the CWD) ---
STORAGE_DIR=storage
# Optional overrides; default to sub-directories of STORAGE_DIR. A relative SQLite path
# in DATABASE_URL is also resolved against the project root.
# DATABASE_URL=sqlite:///storage/database/app.db
# CHROMA_DIR=storage/chroma

# --- Public deployments only ---
# When set, the web interface asks visitors for this password before they can use it.
# Leave empty on your own computer.
ACCESS_PASSWORD=

# --- Upload limits ---
MAX_UPLOAD_MB=30

# --- LLM (Google Gemini via the google-genai SDK) ---
# Without a key, documents are still processed and indexed; knowledge extraction is
# skipped. The app passes this key to the SDK explicitly, so a GOOGLE_API_KEY in your
# shell is not used. Review the provider's current data-use terms before analysing
# unpublished or confidential papers.
# LLM_PROVIDER: auto (OpenRouter for an sk-or- key, else Google SDK) | gemini | openrouter
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=90
# Retries for timeouts and server errors; a used-up quota is never retried.
LLM_MAX_RETRIES=1
# Reasoning effort: minimal | low | medium | high | default
LLM_THINKING_LEVEL=low
# Re-asks when the model's JSON does not match the schema.
LLM_INVALID_OUTPUT_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=16384
# Passage tokens sent per extraction call (3 parallel calls per paper).
EXTRACTION_PASSAGE_TOKEN_BUDGET=8000

# --- Embeddings (local; downloaded from Hugging Face on first use, ~420 MB) ---
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-cos-v1
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# After the first download, set HF_HUB_OFFLINE=1 to stop sentence-transformers from
# contacting huggingface.co for update checks (no document data is ever sent).
# HF_HUB_OFFLINE=1

# --- Document processing ---
# Tesseract is a system program (not a pip package). Leave empty if it is on PATH,
# otherwise give the full path to tesseract(.exe). Without it, scanned pages are
# marked "ocr_unavailable" and the document is only partially indexed.
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_DPI=300
# Pages with fewer extractable characters than this are treated as scanned.
OCR_MIN_TEXT_CHARS=40
# Chunk sizes in embedding-model word pieces (starting values; tune by evaluation).
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
CHUNK_MAX_TOKENS=256
# References/acknowledgements are stored but not embedded unless this is true.
INDEX_REFERENCES=false

# --- Retrieval ---
SEMANTIC_CANDIDATES=8
BM25_CANDIDATES=8

# --- Workflow ---
MAX_VERIFICATION_RETRIES=2

# --- Third-party telemetry ---
ANONYMIZED_TELEMETRY=False
